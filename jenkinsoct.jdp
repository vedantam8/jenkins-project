pipeline {
  agent any
    stages {
      stage (PULL) {
            steps {
                git branch: 'main', url: 'https://github.com/vedantam8/jenkins-project.git'
                echo 'pull success'
            }
        }
        stage (BUILD) {
            steps {
                dir('backend'){
                sh 'mvn clean package -DskipTests' 
                }
                echo 'build success'
            }
        }
        stage (TEST) {
            steps {
                echo 'test success'
            }
        }
        stage (DEPLOY){
            steps {
                echo 'deploy success'
            }
        }
    }
}