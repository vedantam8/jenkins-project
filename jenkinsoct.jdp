pipeline {
  agent any
    stages {
      stage (PULL) {
            steps {
                git branch: 'main', url: 'https://github.com/vedantam8/jenkins-project.git'
                echo 'pull success'
            }
        }
        stage (BUILD) {
            steps {
                dir('backend'){
                sh 'mvn clean package -DskipTests' 
                }
                echo 'build success'
            }
        }
        stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'sonarqube',
                    credentialsId: 'sonar-cred'
                ) {
                    dir('backend') {
                        sh '''mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
  -Dsonar.projectKey=test-project \
  -Dsonar.projectName='test-project'
'''
                    }
                }

                echo 'TEST-SUCCESS'
            }
        }

        stage (DEPLOY){
            steps {
                echo 'deploy success'
            }
        }
    }
}
